# Local demo only. Generate two DIFFERENT secrets before starting (see README).
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
BFF_PORT=3000
BFF_HOST=127.0.0.1
VITE_BFF_TARGET=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:8000
SESSION_SECRET=replace-with-a-random-session-secret-at-least-32-chars
INTERNAL_JWT_SECRET=replace-with-a-different-random-jwt-secret-at-least-32-chars
ENABLE_DEMO_LOGIN=true
DATABASE_URL=postgresql+psycopg://enterprise:enterprise_local@127.0.0.1:55432/enterprise_agent
POSTGRES_USER=enterprise
POSTGRES_PASSWORD=enterprise_local
POSTGRES_DB=enterprise_agent
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
POSTGRES_HOST_PORT=55432

# P1: backend only. Never prefix these variables with VITE_.
# The endpoint must support /chat/completions and JSON object responses.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1600
AGENT_TIMEZONE=Asia/Hong_Kong
AGENT_CONFIRMATION_TTL_SECONDS=900
