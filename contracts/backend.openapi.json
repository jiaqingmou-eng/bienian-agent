  "components": {
    "schemas": {
      "CreateExpenseRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Title"
          },
          "purpose": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Purpose"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExpenseItemRequest"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "purpose",
          "items"
        ],
        "title": "CreateExpenseRequest",
        "description": "创建草稿请求；申请人、企业、总额和状态由服务端确定，不能由客户端指定。"
      },
      "DemoAccountResponse": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "employee",
              "finance"
            ],
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "name",
          "role"
        ],
        "title": "DemoAccountResponse",
        "description": "演示登录页可显示的账号资料，不包含认证凭据。"
      },
      "DemoLoginRequest": {
        "properties": {
          "account_key": {
            "type": "string",
            "enum": [
              "employee_a",
              "employee_b",
              "finance"
            ],
            "title": "Account Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "account_key"
        ],
        "title": "DemoLoginRequest",
        "description": "本地演示登录请求；账号只能从预先配置的演示账号中选择。"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorResponse",
        "description": "统一错误响应；requestId 用于将用户反馈与服务端日志关联。"
      },
      "ExpenseItemRequest": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "transport",
              "lodging",
              "meal",
              "other"
            ],
            "title": "Category"
          },
          "incurred_on": {
            "type": "string",
            "format": "date",
            "title": "Incurred On"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Description"
          },
          "amount_fen": {
            "type": "integer",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Fen"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "category",
          "incurred_on",
          "description",
          "amount_fen"
        ],
        "title": "ExpenseItemRequest",
        "description": "创建报销时提交的一条费用明细。金额使用整数分，拒绝字符串和小数。"
      },
      "ExpenseItemResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "transport",
              "lodging",
              "meal",
              "other"
            ],
            "title": "Category"
          },
          "incurred_on": {
            "type": "string",
            "format": "date",
            "title": "Incurred On"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "amount_fen": {
            "type": "integer",
            "title": "Amount Fen"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "category",
          "incurred_on",
          "description",
          "amount_fen"
        ],
        "title": "ExpenseItemResponse",
        "description": "返回给客户端的费用明细字段。"
      },
      "ExpenseListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExpenseResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
